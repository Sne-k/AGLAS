# Claude Code project context (local only)
.claude/

# MATLAB
*.asv
*.autosave
*.m~
slprj/
codegen/

# Generated analysis products. Regenerate everything with run_aglas.
# The .mat files are large binaries and are fully reproducible from the
# scripts, so they are not tracked. The figures are kept so the repository
# documents its own results without needing MATLAB to view them.
data/*.mat
results/*.fig
results/*.pdf
animation/*.gif

# OS
.DS_Store
Thumbs.db

# GNU Octave crash-dump workspace
octave-workspace

# Simulink model and cache. build_gla_model.m regenerates the model, so it
# is deliberately not committed (see simulink/README.md).
simulink/*.slx
simulink/*.slxc

# Local copy of the pre-repository scratch files
_pre_repo_backup/
